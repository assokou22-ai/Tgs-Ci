{
  "entities": {
    "ticket": {
      "title": "Repair Ticket",
      "description": "MacBook repair ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "status": { "type": "string" },
        "problemDescription": { "type": "string" },
        "macModel": { "type": "string" },
        "macColor": { "type": "string" },
        "isInfacturable": { "type": "boolean" },
        "infacturableReason": { "type": "string" }
      },
      "required": ["id", "createdAt", "updatedAt", "status", "macModel"]
    },
    "stock": {
      "title": "Stock Item",
      "description": "Inventory stock item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "number" },
        "category": { "type": "string" }
      },
      "required": ["id", "name", "quantity", "category"]
    },
    "stockUsage": {
      "title": "Stock Usage",
      "description": "Inventory material consumption",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "stock_id": { "type": "string" },
        "ticket_id": { "type": "string" },
        "quantite_utilisee": { "type": "number" }
      },
      "required": ["id", "stock_id", "ticket_id", "quantite_utilisee"]
    },
    "externalPurchase": {
      "title": "External Purchase",
      "description": "Collaborator purchase item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticket_id": { "type": "string" },
        "item_name": { "type": "string" },
        "purchase_price": { "type": "number" }
      },
      "required": ["id", "ticket_id", "item_name", "purchase_price"]
    },
    "service": {
      "title": "Repair Service",
      "description": "Predefined repair service item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" }
      },
      "required": ["id", "name", "price"]
    },
    "facture": {
      "title": "Invoice",
      "description": "Client invoice document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "numero": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "numero", "total", "status"]
    },
    "proforma": {
      "title": "Proforma",
      "description": "Proforma quote document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "numero": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "numero", "total", "status"]
    },
    "commande": {
      "title": "Supplier order",
      "description": "Purchase order for parts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "numero": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "numero", "total", "status"]
    },
    "appointment": {
      "title": "Appointment",
      "description": "Customer appointment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientName": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" }
      },
      "required": ["id", "clientName", "date", "time"]
    },
    "simpleDocument": {
      "title": "Simple Document",
      "description": "Simple custom text document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" }
      },
      "required": ["id", "title", "content"]
    },
    "storedDocument": {
      "title": "Stored Document",
      "description": "Base64 database doc file mapping",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "data": { "type": "string" }
      },
      "required": ["id", "name", "data"]
    },
    "suggestions": {
      "title": "Suggestion Set",
      "description": "Auto-complete values for forms",
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "values": { "type": "array" }
      },
      "required": ["category"]
    },
    "dailyBackup": {
      "title": "Daily Backup",
      "description": "Daily automated system backup state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" },
        "payload": { "type": "string" },
        "payloadRef": { "type": "string" }
      },
      "required": ["id", "date", "createdAt"]
    },
    "engagementSav": {
      "title": "SAV Engagement",
      "description": "After-sales warranty commitment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "numeroFicheOrigine": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id"]
    },
    "mouvementStock": {
      "title": "Stock Movement",
      "description": "Detailed stock reservation and exit movement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "article_stock_id": { "type": "string" },
        "type_mouvement": { "type": "string" },
        "quantite": { "type": "number" },
        "date_mouvement": { "type": "string" }
      },
      "required": ["id", "article_stock_id", "type_mouvement"]
    },
    "deviceSession": {
      "title": "Device Session",
      "description": "Device connection audit and clock calibration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id"]
    },
    "member": {
      "title": "Authorized Member",
      "description": "Authorized team member account",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["email", "role", "active"]
    },
    "counter": {
      "title": "Ticket Counter",
      "description": "Sequential numbering counters and reservations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "last": { "type": "number" },
        "ticketId": { "type": "string" }
      },
      "required": ["id"]
    },
    "mediaChunk": {
      "title": "Media Chunk",
      "description": "Chunked images, audio, video or large backup payloads",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chunks": { "type": "number" },
        "d": { "type": "string" }
      },
      "required": ["id"]
    },
    "settings": {
      "title": "Settings",
      "description": "Application settings and API server discovery",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "tickets/{ticketId}": {
      "schema": "ticket",
      "description": "MacBook repair tickets database"
    },
    "stock/{stockId}": {
      "schema": "stock",
      "description": "Inventory stock items"
    },
    "stockUsage/{usageId}": {
      "schema": "stockUsage",
      "description": "Inventory materials mapping"
    },
    "externalPurchases/{purchaseId}": {
      "schema": "externalPurchase",
      "description": "External supplier mapping"
    },
    "services/{serviceId}": {
      "schema": "service",
      "description": "Service definitions"
    },
    "factures/{factureId}": {
      "schema": "facture",
      "description": "Client invoice database"
    },
    "proformas/{proformaId}": {
      "schema": "proforma",
      "description": "Client proforma database"
    },
    "commandes/{commandeId}": {
      "schema": "commande",
      "description": "Parts order database"
    },
    "appointments/{appointmentId}": {
      "schema": "appointment",
      "description": "Client appointments calendar"
    },
    "simpleDocuments/{docId}": {
      "schema": "simpleDocument",
      "description": "Custom simple sheets"
    },
    "storedDocuments/{storedId}": {
      "schema": "storedDocument",
      "description": "User manual uploads"
    },
    "suggestions/{categoryId}": {
      "schema": "suggestions",
      "description": "Autocomplete suggestion tags"
    },
    "dailyBackups/{backupId}": {
      "schema": "dailyBackup",
      "description": "Automated closing-hour backups database"
    },
    "engagementsSav/{savId}": {
      "schema": "engagementSav",
      "description": "After-sales warranty commitments"
    },
    "mouvementsStock/{mouvementId}": {
      "schema": "mouvementStock",
      "description": "Stock reservation and usage movements"
    },
    "deviceSessions/{sessionId}": {
      "schema": "deviceSession",
      "description": "Device session history and clock calibration"
    },
    "members/{memberEmail}": {
      "schema": "member",
      "description": "Authorized team members by lowercase email"
    },
    "counters/{counterId}": {
      "schema": "counter",
      "description": "Sequential ticket counters and temporary reservations"
    },
    "media/{mediaId}": {
      "schema": "mediaChunk",
      "description": "Chunked media blobs outside ticket documents"
    },
    "settings/{settingsId}": {
      "schema": "settings",
      "description": "Global workshop settings and API origin registry"
    }
  }
}
